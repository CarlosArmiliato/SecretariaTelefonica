<Window
    x:Class="Joana.Desktop.Views.DialConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirmar discagem"
    Width="520"
    MinHeight="360"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    AutomationProperties.Name="Confirmação final de discagem"
    AutomationProperties.HelpText="Confirme uma única tentativa somente depois de revisar o destino e o objetivo"
    KeyboardNavigation.TabNavigation="Local">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Confirmação final" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,20" Text="Esta confirmação vale somente para a tentativa atual. Não haverá retry automático, mensagem de voz ou aceite de orçamento." TextWrapping="Wrap" />

            <Grid AutomationProperties.Name="Vínculo da confirmação">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,12,6" FontWeight="SemiBold" Text="Empresa" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,6" Text="{Binding CompanyName}" TextWrapping="Wrap" AutomationProperties.Name="Empresa da chamada" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,6" FontWeight="SemiBold" Text="Número" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6" Text="{Binding PhoneNumber}" AutomationProperties.Name="Número da chamada" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,6" FontWeight="SemiBold" Text="Objetivo" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6" Text="{Binding Objective}" TextWrapping="Wrap" AutomationProperties.Name="Objetivo da chamada" />
            </Grid>

            <Separator Margin="0,20,0,14" />
            <CheckBox x:Name="ConfirmationInput" Content="Confirmo esta tentativa única para a empresa, o número e o objetivo exibidos acima." IsChecked="{Binding ConfirmationAccepted, Mode=TwoWay}" AutomationProperties.Name="Confirmar tentativa única" AutomationProperties.HelpText="A confirmação é válida somente para os dados exibidos nesta janela." />
            <TextBlock Margin="0,10,0,0" Text="Modo: simulação. Carlos deve permanecer disponível para supervisionar." TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Foreground="#B00020" Text="{Binding ConfirmationError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelDialCommand}" IsCancel="True" MinWidth="100" MinHeight="40" Margin="0,0,10,0" AutomationProperties.Name="Cancelar discagem" />
                <Button Content="Confirmar e discar" Command="{Binding ConfirmAndDialCommand}" IsDefault="True" IsEnabled="{Binding CanConfirm}" MinWidth="150" MinHeight="40" AutomationProperties.Name="Confirmar e discar" AutomationProperties.HelpText="Consome a confirmação e permite no máximo uma ação simulada." />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
